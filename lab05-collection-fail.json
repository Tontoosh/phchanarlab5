      "description": "Бие даасан тест: энэ хавтас дахь setup PUT хүсэлтүүдийг эхэлж, дараа нь POST хүсэлтийг ажиллуулна. Байхгүй гэж заасан ID-г үүсгэхгүй.",
      "item": [
        {
          "name": "Setup PUT /students/S_TC01",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseURL}}/students/S_TC01",
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"active\", \"coursesTaken\": [\"CS201\", \"CS202\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Setup: result = OK\", () => pm.expect(pm.response.json()).to.eql({ result: \"OK\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup PUT /courses/CS301",
          "request": {
            "method": "PUT",
            "header": [
