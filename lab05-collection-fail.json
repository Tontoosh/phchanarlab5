            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Setup: result = OK\", () => pm.expect(pm.response.json()).to.eql({ result: \"OK\" }));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC01 — Идэвхтэй оюутан бүх урьдач нөхцөлийг хангасан үед OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseURL}}/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"S_TC01\", \"courseID\": \"CS301\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP статус 200 (зориуд буруу oracle)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON Content-Type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"result = OK\", () => pm.expect(body.result).to.equal(\"OK\"));",
                  "pm.test(\"registrationID нь тоо\", () => pm.expect(body.registrationID).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
